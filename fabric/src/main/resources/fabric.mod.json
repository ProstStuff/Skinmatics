{
    "schemaVersion": 1,
    "id": "${mod_id}",
    "version": "${version}",
    "name": "${mod_name}",
    "description": "${description}",
    "authors": ["${mod_author}"],
    "contact": {
        "homepage": "https://modrinth/skinmatics",
        "sources": "https://github.com/ProstStuff/Skinmatics",
        "issues": "https://github.com/ProstStuff/Skinmatics/issues"
    },
    "license": "${license}",
    "icon": "assets/${mod_id}/textures/icon.png",
    "environment": "client",
    "entrypoints": {
        "client": ["com.fraynn.skinmatics.SkinmaticsFabric"],
        "modmenu": ["com.fraynn.skinmatics.compat.SkinmaticsModMenu"],
        "lambdynlights:initializer": ["com.fraynn.skinmatics.compat.SkinmaticsDynamicLights"]
    },
    "mixins": [
        "${mod_id}.mixins.json",
        "${mod_id}.fabric.mixins.json"
    ],
    "depends": {
        "fabricloader": ">=${fabric_loader_version}",
        "fabric-api": "*",
        "minecraft": "~${minecraft_version}",
        "java": ">=${java_version}",
        "utilitary": ">=${utilitary_version}"
    },
    "custom": {
        "modmenu": {
            "links": {
                "modmenu.patreon": "https://www.patreon.com/cw/Fraynn",
                "modmenu.discord": "https://discord.gg/C82atdWT2w",
                "modmenu.modrinth": "https://modrinth.com/mod/skinmatics"
            },
            "update_checker": true
        }
    }
}
  