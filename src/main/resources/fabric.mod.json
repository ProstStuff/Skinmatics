{
	"schemaVersion": 1,
	"id": "skinmatics",
	"version": "${version}",
	"name": "Skinmatics",
	"description": "An extensive yet simple avatar customization mod",
	"authors": [
		"ProstStuff, CallMeFreyya"
	],
	"contributors": [],
	"contact": {
		"homepage": "https://modrinth/skinmatics",
		"sources": "https://github.com/ProstStuff/Skinmatics",
		"issues": "https://github.com/ProstStuff/Skinmatics/issues"
	},
	"license": "All Rights Reserved",
	"icon": "assets/skinmatics/textures/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"dev.proststuff.skinmatics.SkinmaticsClient"
		],
		"modmenu": [
			"dev.proststuff.skinmatics.client.compat.SkinmaticsModMenu"
		],
		"lambdynlights:initializer": [
			"dev.proststuff.skinmatics.client.compat.SkinmaticsDynamicLights"
		]
	},
	"mixins": [
		"skinmatics.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.2",
		"minecraft": "~26.1",
		"java": ">=25",
		"fabric-api": "*",
		"utilitary": ">=1.0.0-alpha"
	},

	"custom": {
		"modmenu": {
			"links": {
				"modmenu.discord": "https://discord.gg/C82atdWT2w",
				"modmenu.modrinth": "https://modrinth.com/mod/skinmatics",
				"modmenu.kofi": "https://ko-fi.com/proststuff"
			},
			"update_checker": true
		}
	},

	"accessWidener": "skinmatics.classtweaker"
}